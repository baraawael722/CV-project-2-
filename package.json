{
  "name": "cv-project-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "Backend",
    "my-react-app"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend,ml -c blue,magenta,green --restart-tries 99 --restart-after 3000 --success none \"npm:backend:dev\" \"npm:frontend:dev\" \"npm:ml:dev\"",
    "dev:no-ml": "concurrently -n backend,frontend -c blue,magenta --restart-tries 99 --restart-after 3000 --success none \"npm:backend:dev\" \"npm:frontend:dev\"",
    "dev:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start_all_services.ps1",
    "start": "npm run start --workspace Backend",
    "build": "npm run build --workspace my-react-app",
    "install:all": "npm install",
    "backend:dev": "npm run dev --workspace Backend",
    "frontend:dev": "npm run dev --workspace my-react-app",
    "ml:dev": "cd ml-service && python cv_classifier_hybrid.py"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
